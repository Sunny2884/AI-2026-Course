{
    "checkpoint_dir": "weights_mask2former/swin_base_coco_instance",
    "mode": "rgbd",
    "num_channels": 4,
    "num_labels": 1,
    "data_root": "./dataset",
    "output_dir": "outputs/finetune",
    "init_from": "outputs/pretrain/best.pth",
    "epochs": 6,
    "batch_size": 1,
    "grad_accum": 4,
    "workers": "auto",
    "learning_rate": 0.00002,
    "weight_decay": 0.05,
    "warmup_iters": 200,
    "jitter": [1.0, 2.3],
    "crop_size": 1024,
    "small_crop_prob": 0.5,
    "amp_dtype": "bf16",
    "max_grad_norm": 0.01,
    "score_threshold": 0.001,
    "num_gpus": 4,
    "device": "cuda",
    "seed": 42,
    "limit_train": 0,
    "limit_val": 0,
    "resume": null
}
